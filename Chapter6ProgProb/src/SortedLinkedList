import java.util.Comparator;

public class SortedLinkedList extends SinglyLinkedList {
    private Comparator<Song> comparator;

    public SortedLinkedList(Comparator<Song> comparator) {
        this.comparator = comparator;
    }

    @Override
    public void add(int index, Song song) {
        // Ignore index parameter and insert in sorted order
        insertSorted(song);
    }

    public void add(Song song) {
        insertSorted(song);
    }

    private void insertSorted(Song song) {
        Node newNode = new Node(song);

        // If list is empty or new song belongs at the very beginning
        if (head == null || comparator.compare(song, head.data) < 0) {
            newNode.next = head;
            head = newNode;
            if (tail == null) {
                tail = newNode;
            }
            return;
        }

        // Traverse to find the correct spot
        Node current = head;
        while (current.next != null && comparator.compare(song, current.next.data) >= 0) {
            current = current.next;
        }

        newNode.next = current.next;
        current.next = newNode;

        if (newNode.next == null) {
            tail = newNode;
        }
    }
}
